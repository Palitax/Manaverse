# Supabase Configuration (Optional - platform functions out of the box with reactive state)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Discord Webhooks (Can also be configured live in the /admin dashboard)
DISCORD_WEBHOOK_SELL=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_TRADE=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_LOOKING_FOR=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_MANACARDS_BULK=https://discord.com/api/webhooks/...

# Discord OAuth (Optional for server-side auth)
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
NEXTAUTH_URL=http://localhost:3000
